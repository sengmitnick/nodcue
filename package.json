{
  "name": "nod-pronouncer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node server/index.js",
    "db:migrate": "node server/migrate.js",
    "pack": "mkdir -p dist deliverables && aix pack src -o dist/nod-pronouncer.aix -O && cp dist/nod-pronouncer.aix deliverables/nod-pronouncer.aix",
    "inspect": "aix list dist/nod-pronouncer.aix",
    "preview": "aix preview src --dev"
  },
  "devDependencies": {
    "@yodaos-pkg/aix-cli": "0.8.2",
    "pg-mem": "^3.0.14"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
